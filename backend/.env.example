# TradeMind AI — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git.

# ── LLM ──────────────────────────────────────────────────────────────────────
# Get your key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Optional evidence-bound Lab narration. Defaults to false and cannot submit
# orders, alter risk controls, or replace verified facts/metrics.
RESEARCH_ASSISTANT_ENABLED=false

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Database ──────────────────────────────────────────────────────────────────
# Path to the SQLite database file (relative to backend/)
DATABASE_URL=sqlite:///./trademind_v2.db

# ── Sandbox Defaults ─────────────────────────────────────────────────────────
# Starting virtual cash balance for new wallets
DEFAULT_WALLET_BALANCE=15000

# ── Investment Lab historical-data storage ───────────────────────────────────
# Local directory for raw, validated, derived, and provenance artifacts.
LAB_DATA_ROOT=./data/lab

# ── Groww market data (optional, server-side only) ───────────────────────────
# Keep disabled until your active Groww API subscription and permitted endpoints
# have been verified. Never place the token in frontend variables or source code.
GROWW_API_ENABLED=false
GROWW_ACCESS_TOKEN=
