# ── TradeMind AI — Environment Variables ─────────────────────────────────────
# Copy this file to .env and populate values. NEVER commit .env to git.

# ── LLM ──────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ── Alpaca Paper Trading ──────────────────────────────────────────────────────
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# ── Safety Configuration ──────────────────────────────────────────────────────
# STRICT_MODE=true means all file writes are gated behind an explicit check
STRICT_MODE=true
# Maximum allowed daily drawdown before the hard kill-switch fires (fraction)
MAX_DAILY_DRAWDOWN=0.02
# Maximum single-position size as fraction of total capital
MAX_POSITION_SIZE=0.05
# VIX proxy threshold — trades blocked above this implied volatility level
MAX_VIX_THRESHOLD=30.0

# ── Admin ─────────────────────────────────────────────────────────────────────
# Used to authenticate the kill-switch reset endpoint
ADMIN_SECRET_TOKEN=change_me_to_a_long_random_string

# ── Server ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Model Checkpoint ─────────────────────────────────────────────────────────
# Path to a pre-trained PPO checkpoint; leave blank to start fresh
PPO_CHECKPOINT_PATH=
